  "description": "Spawn multiple Claude terminals and execute commands with real-time logging using node-pty",
  "main": "main.ts",
  "scripts": {
    "start": "npx ts-node main.ts",
    "install-deps": "npm install",
    "build": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
