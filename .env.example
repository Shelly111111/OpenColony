# Anthropic API Configuration
# 此文件为模板，实际使用时请复制为 .env 并填入真实值
# （UI 设置页保存时会自动写入 .env）

# Anthropic API Key（必填）
ANTHROPIC_API_KEY=

# Anthropic API 端点（留空使用官方默认 https://api.anthropic.com）
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 使用的模型名称
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# HuggingFace 镜像端点（国内网络建议配置，如 https://hf-mirror.com）
HF_ENDPOINT=

# 向量语义搜索返回数量（默认 3）
EMBEDDING_TOPN=3
